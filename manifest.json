{
  "manifestVersion": 1,
  "meta": {
    "name": "Test Pup",
    "version": "1.0.5",
    "logoPath": "logo.png",
    "shortDescription": "A minimal test pup for Dogeboox testing",
    "longDescription": "Test Pup is a minimal application that logs its version. Used for testing Dogebox functionality.",
    "upstreamVersions": null
  },
  "config": {
    "sections": [
      {
        "name": "required_settings",
        "title": "Required Settings",
        "fields": [
          {
            "name": "server_url",
            "label": "Server URL",
            "type": "text",
            "required": true,
            "help": "The URL of the server to connect to"
          }
        ]
      },
      {
        "name": "optional_settings",
        "title": "Optional Settings",
        "fields": [
          {
            "name": "enable_metrics",
            "label": "Enable Metrics",
            "type": "toggle",
            "required": false,
            "default": true,
            "help": "Enable performance metrics collection"
          }
        ]
      }
    ]
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "f0a9e2f57586fe5e286c8471aef4a4cefbe14a4c71267de895f3f0dcb7c61a19"
    },
    "services": [
      {
        "name": "test-pup",
        "command": {
          "exec": "/bin/run.sh",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "UI",
        "type": "http",
        "port": 1234,
        "interfaces": null,
        "listenOnHost": false,
        "webUI": true
      }
    ],
    "requiresInternet": false
  },
  "interfaces": null,
  "dependencies": [],
  "metrics": null
}
